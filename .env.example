# Shared secret required on every POST /ivr-engine request (header
# x-ivr-shared-secret) — mjunction must send the same value. Also used to
# authenticate mjunction's incoming webhook call, in the opposite direction.
IVR_SHARED_SECRET=

# mjunction's telephony webhook — POSTed to after a call finalizes/gets a
# recording, so mjunction can refresh its call_records rollup (VOC/Reports).
PORTAL_WEBHOOK_URL=https://your-mjunction-domain/api/telephony/webhook

# No SUPPORT_*/TELECALLER_* keys any more — the live call transfer is retired.
# A caller who presses 2 hears the escalation message and hangs up; an agent
# picks them up from mjunction's escalations queue instead.